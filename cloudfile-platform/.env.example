# Copy to .env and adjust as needed.

# Shared
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth service
AUTH_DATABASE_URL=postgresql+asyncpg://cloudfile:cloudfile@postgres:5432/cloudfile_auth

# Files service
FILES_DATABASE_URL=postgresql+asyncpg://cloudfile:cloudfile@postgres:5432/cloudfile_files
S3_BUCKET_NAME=cloudfile-uploads
S3_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PRESIGNED_URL_EXPIRE_SECONDS=3600
NOTIFICATION_SERVICE_URL=http://host.docker.internal:8004

# Search service
SEARCH_DATABASE_URL=postgresql+asyncpg://cloudfile:cloudfile@postgres:5432/cloudfile_files

# Postgres (compose)
POSTGRES_USER=cloudfile
POSTGRES_PASSWORD=cloudfile
POSTGRES_MULTIPLE_DATABASES=cloudfile_auth,cloudfile_files
