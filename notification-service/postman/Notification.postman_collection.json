{
  "info": {
    "name": "Notification Service",
    "description": "Standalone collection for the notification microservice. /notify requires a JWT signed with the SAME JWT_SECRET_KEY as the service. Easiest path: run 'Get token (via auth)' which logs into the platform's auth service and saves {{token}}. If you run notification without the platform, paste a valid token into the {{token}} variable manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "notify_url", "value": "http://localhost:8004" },
    { "key": "auth_url", "value": "http://localhost:8001" },
    { "key": "email", "value": "me@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{notify_url}}/health" }
    },
    {
      "name": "Get token (via auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login ok', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('token', json.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{auth_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "description": "Requires the platform's auth service running on 8001. Register that user first if needed."
      }
    },
    {
      "name": "Send notification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('created', function () { pm.response.to.have.status(201); });",
              "pm.test('status sent', function () { pm.expect(pm.response.json().status).to.eql('sent'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{notify_url}}/api/v1/notifications/notify",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"{{email}}\",\n  \"subject\": \"Hello\",\n  \"message\": \"A test notification\",\n  \"channel\": \"email\"\n}"
        }
      }
    },
    {
      "name": "List my notifications",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{notify_url}}/api/v1/notifications"
      }
    }
  ]
}
