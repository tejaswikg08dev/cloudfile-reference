LOG_LEVEL=INFO
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://notify:notify@localhost:5433/notifications
JWT_SECRET_KEY=change-me-use-a-long-random-string
JWT_ALGORITHM=HS256

# Provider: console (default, logs only) | smtp (Mailtrap/real email) | ses (AWS)
NOTIFICATION_PROVIDER=console

# ---- SMTP / Mailtrap (for seeing real emails locally) ----
# Get these from your Mailtrap sandbox inbox → SMTP Settings → "SMTP" creds.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@cloudfile.example.com
SMTP_USE_TLS=true

# ---- AWS SES (production email) ----
AWS_REGION=us-east-1
SES_SENDER=no-reply@cloudfile.example.com
