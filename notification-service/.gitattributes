# Force LF line endings for files that run inside Linux containers.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.mako          text eol=lf

* text=auto eol=lf
